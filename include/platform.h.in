#ifndef BMT_PLATFORM_H
#define BMT_PLATFORM_H

#define BMT_VERSION_MAJOR @bmt_VERSION_MAJOR @
#define BMT_VERSION_MINOR @bmt_VERSION_MINOR @
#define BMT_VERSION_PATCH @bmt_VERSION_PATCH @

#cmakedefine BMT_HAVE_BST_MAJOR_INCLINED
#cmakedefine BMT_STATIC_BUILD
#cmakedefine BMT_PLATFORM_WINDOWS
#cmakedefine BMT_PLATFORM_MACOS
#cmakedefine BMT_PLATFORM_LINUX

#ifndef BMT_STATIC_BUILD
#if defined(BMT_PLATFORM_WINDOWS)
#if defined(BMT_EXPORTS)
#define BMT_API __declspec(dllexport)
#else
#define BMT_API __declspec(dllimport)
#endif
#else
#define BMT_API __attribute__((visibility("default")))
#endif
#else
#define BMT_API
#endif

#if defined(__clang__)
#define BMT_COMPILER_CLANG
#elif defined(__GNUC__) || defined(__GNUC__)
#define BMT_COMPILER_GNUC
#elif defined(_MSC_VER)
#define BMT_COMPILER_MSC
#endif

#endif